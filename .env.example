# Copy to .env for local development (netlify dev). In production set these in Netlify > Site configuration > Environment variables.
# NEVER commit the real .env file.

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# SECRET - server-side only (used by Netlify Functions). Never put this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Phone push notifications (see docs/SETUP-GUIDE.md section 9)
PUSH_WEBHOOK_SECRET=same-long-random-text-as-in-supabase-push-sql
FCM_SERVICE_ACCOUNT=

# Optional email notifications (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="My Printing Shop <orders@yourdomain.com>"
NOTIFY_EMAIL=owner@example.com
